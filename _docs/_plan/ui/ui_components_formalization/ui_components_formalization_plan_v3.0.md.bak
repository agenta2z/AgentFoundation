  ],
  jsx: 'automatic',
  outExtension: ({ format }) => ({ js: format === 'esm' ? '.mjs' : '.cjs' }),
});
```

### 4.4 `WidgetRegistry.js` — finally extensible

```js
import { WIDGET_TYPES } from './widgetTypes';

const _registry = new Map();

export function registerWidget(type, Component, { override = false } = {}) {
  if (!type || typeof type !== 'string') {
    throw new TypeError('registerWidget(type, Component): type must be a non-empty string');
  }
  const isBuiltin   = WIDGET_TYPES.includes(type);
  const isNamespaced = type.includes('.');
  if (!isBuiltin && !isNamespaced) {
    console.warn(`registerWidget: "${type}" is neither built-in nor namespaced; prefer "ns.type".`);
  }
  if (_registry.has(type) && !override) {
    throw new Error(`registerWidget: "${type}" already registered. Pass {override:true} to replace.`);
  }
  _registry.set(type, Component);
}

export function getWidget(type) {
  return _registry.get(type) ?? _registry.get('default');
}

export function unregisterWidget(type) { _registry.delete(type); }
export function listRegisteredWidgets() { return Array.from(_registry.keys()); }
```

### 4.5 Phase-1 batch (low-risk pure primitives)

| Source path | New path |
|-------------|----------|
| `webui/react/src/components/common/{EmptyState,LoadingIndicator,PersonChip,ProgressBar,QuickLinkButton,SectionCard,StatusBadge,WelcomeScreen,PlanModeSelector,ClickToEditMarkdown}.js` | `widgets/src/common/` |
| `webui/react/src/theme/{ThemeProvider,createAppTheme,cssVariableBridge,themeRegistry,ThemeSwitcher}.js` | `widgets/src/theme/` |
| OpenStartup `theme/themes/{dark,atlassian,pinterest}.js` | `widgets/src/theme/themes/` (PROMOTE) |
| OpenStartup `hooks/{useApiData,useServerStatus}.js` | `widgets/src/hooks/` (PROMOTE) |
| `webui/react/src/hooks/{useFileViewer,useContextMenu,useInputFields,useSectionVisibility,useProgressHeader}.js` | `widgets/src/hooks/` |

**Critical reconciliation in this phase:**

- **`MarkdownRenderer.js`**:
  - Start from AF.
  - Fix `theme.custom.surfaces.*` → `theme?.custom?.surfaces?.*` with
    fallbacks.
  - Merge OS's `preprocessContent()` Unicode bullet normalization
    (verified at lines 160–174).
  - Library owns `react-markdown`/`remark-gfm`/`react-syntax-highlighter`
    as deps.
- **`ThemeProvider.js`**: already `createThemeFn`-prop-driven (verified).
  Just move it; document the MUI 5/7 cross-version pattern.

### 4.6 Wire AF `webui/react/` to consume `widgets/`

`webui/react/package.json`:
```diff
"dependencies": {
+ "@agent-foundation/ui-react": "file:../../widgets",
   ...
}
```
After `npm install && npm run build` in `widgets/`, the demo's old
imports either: (a) get replaced with `@agent-foundation/ui-react`
imports, or (b) are left in place via re-export shims in
`webui/react/src/components/common/X.js` → one-liner that imports from
the library. Choice (b) keeps the Phase-1 diff small.

### 4.7 Phase-1 exit criteria

- `widgets/` builds (`npm run build`) producing both CJS + ESM `dist/`.
- `npm run sync:check` green.
- AF demo runs visually unchanged.
- Vitest snapshot tests pass for every promoted component.

