### 4.3 `tsup.config.ts`

```ts
import { defineConfig } from 'tsup';

export default defineConfig({
  entry: {
    index:    'src/index.js',
    theme:    'src/theme/index.js',
    protocol: 'src/protocol/index.js',
  },
  format: ['esm', 'cjs'],
  outDir: 'dist',
  splitting: false,
  sourcemap: true,
  clean: true,
  treeshake: true,
  external: ['react', 'react-dom', '@mui/material', '@mui/icons-material', '@emotion/react', '@emotion/styled'],
  jsx: 'automatic',
  outExtension: ({ format }) => ({ js: format === 'esm' ? '.mjs' : '.cjs' }),
});
```

### 4.4 `WidgetRegistry.js` — finally extensible

```js
// src/protocol/WidgetRegistry.js
import { WIDGET_TYPES } from './widgetTypes';

const _registry = new Map();

export function registerWidget(type, Component, { override = false } = {}) {
  if (!type || typeof type !== 'string') {
    throw new TypeError('registerWidget(type, Component): type must be a non-empty string');
  }
  const isBuiltin = WIDGET_TYPES.includes(type);
  const isNamespaced = type.includes('.');
  if (!isBuiltin && !isNamespaced) {
    // eslint-disable-next-line no-console
    console.warn(`registerWidget: "${type}" is neither a built-in widget type nor namespaced (e.g., "openteam.task"). Prefer namespaced names for app-specific widgets.`);
  }
  if (_registry.has(type) && !override) {
    throw new Error(`registerWidget: "${type}" is already registered. Pass {override:true} to replace.`);
  }
  _registry.set(type, Component);
}

export function getWidget(type) {
  return _registry.get(type) ?? _registry.get('default');
}

export function unregisterWidget(type) {
  _registry.delete(type);
}

export function listRegisteredWidgets() {
  return Array.from(_registry.keys());
}
```

This **closes the verified gap** that the original AF registry had only
`getWidget` and no extension hook.

