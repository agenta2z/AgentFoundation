# @nocommit - base_module="" is required for simple relative imports

load("@fbcode_macros//build_defs:python_library.bzl", "python_library")

python_library(
    name = "agent_foundation",
    srcs = glob([
        "agent_foundation/**/*.py",
    ]),
    # Bundle the framework's data files alongside the .py sources so consumers
    # built via Buck (e.g. the conversational AI host, derived-tool dispatcher,
    # SOP runner) can ``load_tool`` / load prompt templates at runtime. Without
    # this, ``Path(__file__).parent/"tool.json"`` would FileNotFoundError inside
    # a buck-out link-tree because non-.py files would be absent.
    resources = glob([
        "agent_foundation/**/*.json",
        "agent_foundation/**/*.jinja2",
        "agent_foundation/**/*.jinja",
        "agent_foundation/**/*.j2",
        "agent_foundation/**/*.yaml",
        "agent_foundation/**/*.yml",
        "agent_foundation/**/*.md",
        "agent_foundation/**/*.toml",
    ]),
    base_module = "",
    typing = False,
    visibility = ["PUBLIC"],
    deps = [
        "fbsource//third-party/pypi/attrs:attrs",
        "fbsource//third-party/pypi/beautifulsoup4:beautifulsoup4",
        "fbsource//third-party/pypi/boto3:boto3",
        "fbsource//third-party/pypi/botocore:botocore",
        "fbsource//third-party/pypi/claude-agent-sdk:claude-agent-sdk",
        "fbsource//third-party/pypi/dash:dash",
        "fbsource//third-party/pypi/dash-bootstrap-components:dash-bootstrap-components",
        # NOTE: dash-cytoscape removed — not present in third-party/pypi.
        # The agent_foundation inferencer code doesn't need it; UI components
        # that reference it will fail at runtime if instantiated.
        "fbsource//third-party/pypi/flask:flask",
        "fbsource//third-party/pypi/httpx:httpx",
        "fbsource//third-party/pypi/hydra-core:hydra-core",
        "fbsource//third-party/pypi/jinja2:jinja2",
        # OmegaConf + hydra-core: ``rich_python_utils.config_utils.instantiate``
        # uses Hydra's ``_target_`` resolution to build the topology graph from
        # YAML; OmegaConf is the underlying config object. Both are required
        # for any caller that runs a topology via the task or derived-tool
        # executor.
        "fbsource//third-party/pypi/lancedb:lancedb",
        "fbsource//third-party/pypi/omegaconf:omegaconf",
        # openai-codex-sdk (lazy-imported by CodexSdkInferencer).
        "fbsource//third-party/pypi/openai-codex-sdk:openai-codex-sdk",
        # NOTE: `lancedb` removed (2026-05-26). Optional knowledge-store backend
        # (used only by ``agent_foundation/knowledge/retrieval/stores/pieces/
        # lancedb_store.py``, which lazily ``import lancedb`` inside
        # ``__attrs_post_init__``). The fbsource third-party package is absent
        # on some checkouts (``fbsource//third-party/pypi/lancedb:`` doesn't
        # exist), which blocks every consumer's Buck build even when nothing
        # actually constructs a ``LanceDBKnowledgePieceStore``. Re-add only
        # after the third-party landing.
        "fbsource//third-party/pypi/plotly:plotly",
        "fbsource//third-party/pypi/prompt-toolkit:prompt-toolkit",
        "fbsource//third-party/pypi/pydantic:pydantic",
        "fbsource//third-party/pypi/pydantic-core:pydantic-core",
        "fbsource//third-party/pypi/pyyaml:pyyaml",
        "fbsource//third-party/pypi/requests:requests",
        "fbsource//third-party/pypi/rich:rich",
        "fbsource//third-party/pypi/websockets:websockets",
        "//_tony_dev/CoreProjects/AgentFoundation/src/agent_foundation/common/inferencers/agentic_inferencers/external/metamate:metamate_lib",
        "//_tony_dev/CoreProjects/RichPythonUtils/src:rich_python_utils",
        "//devai/devmate_sdk/python:devmate_python_sdk",
        "//gen_ai/metagen/pymetagen/lib:metagen",
        # MetaMate inferencer sources are sub-packaged (see
        # agentic_inferencers/external/metamate/BUCK) and would otherwise
        # be excluded from the glob above by the BUCK-package boundary.
        # Re-attach them here so existing imports still work transparently.
    ],
)
