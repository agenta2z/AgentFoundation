# Standalone inferencer test — same SDK inferencer, but uses
# ``//metamate_standalone`` as the source of MetamateGraphQLClient
# (via ``MetamateSDKInferencer(use_standalone=True)``). Verifies the
# whole inferencer + standalone client path works end to end against
# the live MetaMate backend.
python_binary(
    # @autodeps-skip
    name = "test_metamate_standalone_inferencer",
    srcs = ["test_metamate_standalone_inferencer.py"],
    base_module = "",
    main_function = "test_metamate_standalone_inferencer.main",
    typing = False,
    deps = [
        "//_tony_dev/CoreProjects/AgentFoundation/src:agent_foundation",
        "//_tony_dev/CoreProjects/AgentFoundation/src/agent_foundation/common/inferencers/agentic_inferencers/external/metamate:metamate_lib",
        # Test fixture only: mints a CAT to feed the BYO-CAT standalone via
        # the METAMATE_CAT env var. The library under test (:metamate_standalone)
        # has zero libfb/crypto deps; this dep lives on the TEST so the
        # standalone's purity is preserved.
        "//libfb/py/interngraph/auth:interngraph_crypto_auth_token_util",
        # The standalone client (replaces //msl/metamate/cli:metamate_graphql
        # for this binary). The inferencer's resolver picks it up via
        # ``use_standalone=True``.
        "//metamate_standalone:metamate_standalone",
    ],
)
