load("@fbcode_macros//build_defs:python_binary.bzl", "python_binary")

oncall("ml_oncall")

# Real integration tests for MetaMate inferencers — exercised against the
# live MetaMate backend (``engine_start_v2`` / ``get_conversation_for_stream``).
# These are NOT unittest-style; they run as python_binary scripts and print
# pass/fail to stdout. Mirrors the precedent in
# ``test/agent_foundation/common/inferencers/terminal_inferencers/BUCK``
# (e.g. ``test_devmate_inferencer_live``).
#
# Run examples:
#   buck2 run //_tony_dev/CoreProjects/AgentFoundation/test/agent_foundation/common/inferencers/external/metamate:test_metamate_cli_inferencer_real
#   buck2 run //_tony_dev/CoreProjects/AgentFoundation/test/agent_foundation/common/inferencers/external/metamate:test_metamate_sdk_inferencer_real -- --mode async
#
# Every target below uses ``# @autodeps-skip`` because autodeps only follows
# *direct* import edges — it would strip the ``:agent_foundation`` parent
# dep since these test scripts import from
# ``agent_foundation.common.inferencers.agentic_inferencers.external.metamate``
# (which lives in ``:metamate_lib``) but not directly from
# ``agent_foundation.common.inferencers.terminal_inferencers``. The MetaMate
# inferencer modules themselves do the cross-package import at runtime,
# so the parent lib MUST be in every binary's transitive graph.

# CLI real-inference test — single + streaming + deep-research modes via
# the ``query_metamate`` buck target (subprocess fan-out).
python_binary(
    # @autodeps-skip
    name = "test_metamate_cli_inferencer_real",
    srcs = ["test_metamate_cli_inferencer_real.py"],
    base_module = "",
    main_function = "test_metamate_cli_inferencer_real.main",
    typing = False,
    deps = [
        "//_tony_dev/CoreProjects/AgentFoundation/src:agent_foundation",
        "//_tony_dev/CoreProjects/AgentFoundation/src/agent_foundation/common/inferencers/agentic_inferencers/external/metamate:metamate_lib",
    ],
)

# CLI deep-research test — exercises ``SPACES_DEEP_RESEARCH_AGENT`` and
