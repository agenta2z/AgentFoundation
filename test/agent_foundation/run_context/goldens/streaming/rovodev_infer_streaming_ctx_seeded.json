{
  "calls": [
    {
      "active_session_id": "seed-backing-sid",
      "active_session_id_under_ctx": "seed-slot-sid",
      "cli": [
        {
          "argv": [
            "rovodev",
            "legacy",
            "turn 1",
            "--yolo",
            "--restore",
            "seed-slot-sid",
            "--output-file",
            "<TMP>/tmp/rovodev_output_<RAND>.md",
            "--config-override",
            "{\"agent\": {\"modelId\": \"anthropic:claude-opus-4-7\"}}"
          ],
          "cwd": "<TMP>/ws"
        }
      ],
      "construct_command": [
        {
          "active_ctx": {
            "legacy_mint": false,
            "path": "/leaf"
          },
          "kwargs": {
            "output_file": "<TMP>/tmp/rovodev_output_<RAND>.md",
            "resume": true,
            "session_id": "seed-slot-sid"
          }
        }
      ],
      "final_output_under_ctx": "clean answer to 'turn 1' in session seed-slot-sid",
      "get_final_output": null,
      "last_clean_output": null,
      "live_store": {
        "<HEX1> /leaf": {
          "live_session_id": "seed-slot-sid"
        }
      },
      "output": "TUI thinking\nTUI done\n",
      "session_backing": "seed-backing-sid"
    }
  ],
  "host_ctx": {
    "legacy_mint": false,
    "path": "/leaf"
  },
  "sessions_dir": {
    "seed-slot-sid/session_context.json": {
      "json": {
        "workspace_path": "<TMP>/ws"
      }
    }
  }
}
